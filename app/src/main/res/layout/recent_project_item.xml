<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Item layout for displaying recent projects in the sidebar.
  ~ Each item shows a project icon, name, and path.
  ~ Uses a ripple drawable background for touch feedback.
  -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ripple_item_rounded"
    android:padding="@dimen/dimen8dp">

    <!-- Project icon displayed on the left side -->
    <ImageView
        android:id="@+id/file_icon"
        android:layout_width="@dimen/dimen24dp"
        android:layout_height="@dimen/dimen24dp"
        android:layout_centerVertical="true"
        android:contentDescription="@string/project_icon_desc" -->

    <!-- Container for project name and path text -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen5dp"
        android:layout_marginRight="@dimen/dimen5dp"
        android:layout_toEndOf="@id/file_icon"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Project display name, bold and slightly larger -->
        <TextView
            android:id="@+id/file_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/dimen12sp"
            android:textStyle="bold"
            tools:text="CodeOps Studio Projects" />

        <!-- Project file path, italic and smaller; marquee enabled for long paths -->
        <TextView
            android:id="@+id/file_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:maxLines="1"
            android:textSize="@dimen/dimen11sp"
            android:textStyle="italic"
            tools:text="/storage/emulated/0/CodeOps Studio Projects/" />
    </LinearLayout>
</RelativeLayout>
