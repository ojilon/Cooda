{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 1 },
  "configurePresets": [
    {
      "name": "android-ndk-clang",
      "displayName": "Android NDK (Clang, C++23)",
      "description": "AGP externalNativeBuild uses NDK Clang (not GCC).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/android",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      }
    },
    {
      "name": "host-gcc-15",
      "displayName": "Host GCC 15 (C++23)",
      "description": "Desktop build of shared logic with GCC 15.x. APK builds still use NDK Clang.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/host-gcc15",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-15",
        "CMAKE_CXX_COMPILER": "g++-15",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-clang",
      "displayName": "Host Clang (C++23)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/host-clang",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "android-ndk-clang", "configurePreset": "android-ndk-clang" },
    { "name": "host-gcc-15", "configurePreset": "host-gcc-15" },
    { "name": "host-clang", "configurePreset": "host-clang" }
  ]
}
